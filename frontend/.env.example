# Backend base URL (no trailing slash). Inlined at build time by Vite.
VITE_API_URL=http://localhost:8080
# Optional: defaults to the API URL with ws:// or wss:// and /ws/alerts.
# VITE_WS_URL=ws://localhost:8080/ws/alerts
# Optional: sent as X-API-Key when the backend has AUTH_ENABLED=true.
# VITE_API_KEY=
