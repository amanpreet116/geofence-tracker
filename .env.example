# Copy to .env (docker compose reads it automatically). All values are optional.

# Database (used by the db service and to build the backend's DATABASE_URL)
POSTGRES_USER=geofence
POSTGRES_PASSWORD=geofence
POSTGRES_DB=geofence

# Host ports. Change DB_HOST_PORT if a local PostgreSQL already uses 5432.
DB_HOST_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4173

# Backend
ALLOWED_ORIGINS=*
LOG_LEVEL=info
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
AUTH_ENABLED=false
API_KEYS=

# Frontend build args (baked in by Vite at build time; must be reachable from the browser)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/alerts
